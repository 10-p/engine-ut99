# The move stick: the speed at five tilts straight ahead, the direction at stick angles between the axes at full
# and at 0.4 tilt, the player's Walking button held at full tilt, and the stick after that button's release. Every
# sample starts at one spot of DM-Deck16][ with 1,300 units free along yaw 0, its view turned so that the stick's
# direction runs along yaw 0:
#   tools/dev/inputtest/run.sh <run-tree> move.scen <out-dir> 'DM-Deck16][?Game=Botpack.DeathMatchPlus' -SOFTWARERENDERER
#   tools/dev/inputtest/rate.py <out-dir>/game.log 0
# The tags name the tilt and the stick's angle in degrees clockwise from straight ahead (speed-0.4: 0.4 ahead;
# dir-0.4-30: 0.4 at 30 degrees, which rate.py's "move" should read as 30).
waitlog up for play
sleep 3
pad attach
sleep 1
# The match starts on Fire (the right trigger in DefUser.ini's layout, the A button in a retail User.ini).
pad axis righttrigger 32767
pad button a 1
sleep 0.3
pad axis righttrigger 0
pad button a 0
sleep 4
# The pad's Y button is the Walking button, as in DefUser.ini's layout.
exec set input Joy4 Walking
exec TELEPORT -350 -1138 -724 0
sleep 0.3
pad axis lefty -6553
sleep 2.4
watch 20 speed-0.2
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 0
sleep 0.3
pad axis lefty -13107
sleep 2.4
watch 20 speed-0.4
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 0
sleep 0.3
pad axis lefty -19660
sleep 2.4
watch 20 speed-0.6
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 0
sleep 0.3
pad axis lefty -26214
sleep 2.4
watch 20 speed-0.8
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 0
sleep 0.3
pad axis lefty -32767
sleep 2.4
watch 20 speed-1.0
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 63716
sleep 0.3
pad axis leftx 5690
pad axis lefty -32269
sleep 1.2
watch 20 dir-1.0-10
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 60075
sleep 0.3
pad axis leftx 16383
pad axis lefty -28377
sleep 1.2
watch 20 dir-1.0-30
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 54613
sleep 0.3
pad axis leftx 28377
pad axis lefty -16384
sleep 1.2
watch 20 dir-1.0-60
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 50972
sleep 0.3
pad axis leftx 32269
pad axis lefty -5690
sleep 1.2
watch 20 dir-1.0-80
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 63716
sleep 0.3
pad axis leftx 2276
pad axis lefty -12908
sleep 1.2
watch 20 dir-0.4-10
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 60075
sleep 0.3
pad axis leftx 6553
pad axis lefty -11351
sleep 1.2
watch 20 dir-0.4-30
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 54613
sleep 0.3
pad axis leftx 11351
pad axis lefty -6553
sleep 1.2
watch 20 dir-0.4-60
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 50972
sleep 0.3
pad axis leftx 12908
pad axis lefty -2276
sleep 1.2
watch 20 dir-0.4-80
sleep 1.2
pad axis leftx 0
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 0
sleep 0.3
pad button y 1
pad axis lefty -32767
sleep 1.2
watch 20 walkbutton-1.0
sleep 1.2
pad axis leftx 0
pad axis lefty 0
pad button y 0
sleep 0.8
exec TELEPORT -350 -1138 -724 0
sleep 0.3
pad button y 1
pad axis lefty -32767
sleep 0.6
pad button y 0
sleep 1.2
watch 20 walkbutton-released-1.0
sleep 1.2
pad axis lefty 0
sleep 0.8
exec TELEPORT -350 -1138 -724 0
sleep 0.3
pad button y 1
pad axis lefty -13107
sleep 0.6
pad button y 0
sleep 1.2
watch 20 walkbutton-released-0.4
sleep 1.2
pad axis lefty 0
sleep 0.8
probe end
